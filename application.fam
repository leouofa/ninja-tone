# For details & more options, see documentation/AppManifests.md in firmware repo

App(
    appid="tone_ninja",  # Must be unique
    name="Tone Ninja",  # Displayed in menus
    apptype=FlipperAppType.EXTERNAL,
    entry_point="tone_gen_app",
    stack_size=2 * 1024,
    fap_category="Games",
    fap_version="1.0",
    fap_icon="tone_ninja.png",  # 10x10 1-bit PNG
    fap_description="A companion app to ninja roll.",
    fap_author="Leonid Medovyy",
    fap_weburl="https://github.com/leouofa/ninja-tone",
    fap_icon_assets="images",  # Image assets to compile for this application
    sources=["src/*.c", "src/scenes/*.c", "src/system/*.c", "src/utils/*.c"],
)
